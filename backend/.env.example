# Copy this file to backend/.env and replace only the placeholder values.
# Never add backend/.env to Git or share the Razorpay secret.

DATABASE_URL=postgresql+asyncpg://parking_admin:parking_secret_2024@localhost:5432/smart_parking
REDIS_URL=redis://localhost:6379
SECRET_KEY=replace_with_a_long_random_secret

# Gate camera performance defaults for an 8 GB CPU laptop.
GATE_PREVIEW_FPS=8
GATE_PREVIEW_JPEG_QUALITY=75
GATE_DETECTION_INTERVAL_SECONDS=0.35
GATE_YOLO_EVERY_N_SCANS=4
GATE_FAST_CONFIRM_CONFIDENCE=0.70
GATE_PLATE_CONFIRMATIONS=2
GATE_DUPLICATE_COOLDOWN_SECONDS=15
GATE_OPEN_SECONDS=4

# Both Razorpay values must come from the same mode (Test or Live).
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
RAZORPAY_CURRENCY=INR
